# ============================================
# HYPERLIQUID TRADING BOT - Environment Variables
# ============================================

# ----------------
# AI API Keys
# ----------------
# OpenRouter API Key (Fallback) - https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ----------------
# Hyperliquid API (Mainnet)
# ----------------
# Private Key (KEEP SAFE! Never commit this!)
HL_PRIVATE_KEY=your_private_key_here_without_0x

# Account Address (0x...)
HL_ACCOUNT_ADDRESS=0xyour_account_address_here

# ----------------
# Discord Webhooks
# ----------------
# Alerts Webhook (Trading signals, positions, etc.)
DISCORD_WEBHOOK_URL_ALERTS=https://discord.com/api/webhooks/your_webhook_here

# Logs Webhook (System logs, errors, etc.)
DISCORD_WEBHOOK_URL_LOGS=https://discord.com/api/webhooks/your_webhook_here

# ----------------
# App Settings
# ----------------
# Log Level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ----------------
# Notes
# ----------------
# 1. Copy this file to .env and fill in your actual values
# 2. Never commit .env to git (it's in .gitignore)
# 3. Keep your private key secure!

# ==============================================================================
# 🧠 AI MODULAR CONFIGURATION
# ==============================================================================
# See TRADING_PROFILES.md for all available options

# Bot Persona (Default: Conservative Scalper)
# Options: Conservative Scalper | Aggressive Day Trader | Sniper
BOT_PERSONA=Conservative Scalper

# Risk Profile (Default: Capital Preservation First)
# Options: Capital Preservation First | Balanced Growth | High Volatility Hunter
RISK_PROFILE=Capital Preservation First

# Trading Timeframe (Default: 15m)
# Options: 1m | 5m | 15m | 1h | 4h | 1d
TRADING_TIMEFRAME=15m

# Auto-start trading on bot launch
AUTO_START_TRADING=false

