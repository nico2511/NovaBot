# ==============================================================================
# NOVABOT - CONFIGURATION DES IDENTIFIANTS (EXEMPLE)
# Renommez ce fichier en .env et remplissez les valeurs
# ==============================================================================

# --- HYPERLIQUID ---
# Votre clé privée Hyperliquid (sans le 0x au début)
HL_PRIVATE_KEY=votre_cle_privee_ici
# Votre adresse de compte Hyperliquid
HL_ACCOUNT_ADDRESS=0xVotreAdresseIci
# URL de l'API (Défaut: https://api.hyperliquid.xyz)
HYPERLIQUID_API_URL=https://api.hyperliquid.xyz

# --- NOTIFICATIONS DISCORD (OPTIONNEL SI UTILISÉ DANS user_settings.json) ---
# Vous pouvez les remplir ici ou directement dans data/config/user_settings.json
DISCORD_WEBHOOK_URL_ALERTS=https://discord.com/api/webhooks/...
DISCORD_WEBHOOK_URL_LOGS=https://discord.com/api/webhooks/...

# --- IA (OPENROUTER) ---
OPENROUTER_API_KEY=votre_cle_openrouter_ici
# Modèle par défaut (ex: deepseek/deepseek-v3.2)
AI_MODEL_NAME=deepseek/deepseek-v3.2

# --- AUTRES ---
LOG_LEVEL=INFO
AUTO_START_TRADING=false
TRADING_TIMEFRAME=15m
