# ==============================================================================
# NOVABOT — Variables d'environnement
# Copiez ce fichier en .env et remplissez les secrets.
#
# Règle : .env = secrets + infra de déploiement uniquement.
# Config opérationnelle (timeframe, scanner, risk, IA…) → data/config/user_settings.json
# ==============================================================================

# --- HYPERLIQUID (obligatoire) ---
HL_PRIVATE_KEY=
HL_ACCOUNT_ADDRESS=
# Défaut mainnet ; ne changez que pour un environnement de test HL.
HYPERLIQUID_API_URL=https://api.hyperliquid.xyz
# Si true, autorise une clé master (même adresse que HL_ACCOUNT_ADDRESS). Défaut: refuser.
# HL_ALLOW_MASTER_KEY=false

# --- OPENROUTER (obligatoire pour l'IA) ---
OPENROUTER_API_KEY=
# Optionnel : clé management pour GET /credits (solde compte).
OPENROUTER_MANAGEMENT_API_KEY=
# Sonde crédit : au démarrage + intervalle (s). 3600=1h, 86400=1j, 0=démarrage seul.
OPENROUTER_CREDIT_CHECK_INTERVAL_SEC=3600
OPENROUTER_CREDIT_WARN_USD=1.0
OPENROUTER_CREDIT_MIN_USD=0.10

# --- DISCORD (fortement recommandé) ---
# Alternative : section "notifications" dans user_settings.json (hot-reload).
DISCORD_WEBHOOK_URL_ALERTS=
DISCORD_WEBHOOK_URL_LOGS=

# --- API / DÉPLOIEMENT ---
# Port HTTP du serveur FastAPI.
PORT=3001
# Bind loopback par défaut (local-only). 0.0.0.0 = LAN → auth auto si API_KEY_REQUIRED unset.
API_HOST=127.0.0.1
# Clé API pour les endpoints protégés (header X-API-Key).
# Laisser API_KEY_REQUIRED unset = auto (true si bind non-loopback).
API_KEY=
# API_KEY_REQUIRED=false
# Origines autorisées pour CORS (liste CSV).
CORS_ALLOWED_ORIGINS=http://localhost:3001

# --- OPTIONNEL (rare) ---
# Live (défaut). Dry Run bloque les nouvelles entrées, pas un paper exchange.
# EXECUTION_MODE=Live
# Legacy env fallback if scanner whitelist is empty (normally unused):
# TRADING_SYMBOL=BTC
# Debug payload IA (préférez operations.ai_payload_debug dans user_settings.json)
# AI_PAYLOAD_DEBUG=false
# AI_PAYLOAD_DEBUG_DISCORD=false
