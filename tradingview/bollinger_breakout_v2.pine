//@version=5
strategy("Bollinger Breakout V2 (Optimized)", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=95, commission_value=0.06)

// ============================================
// PARAMETERS
// ============================================
bbLength = input.int(20, "BB Length", minval=10, maxval=50)
bbStd = input.float(2.0, "BB Std Dev", minval=1.0, maxval=3.0)
bodyRatioMin = input.float(1.5, "Min Body Ratio", minval=0.5, maxval=3.0)
slPercent = input.float(2.0, "Stop Loss %", minval=0.5, maxval=5.0)
tpPercent = input.float(3.0, "Take Profit %", minval=1.0, maxval=10.0)
useTrendFilter = input.bool(true, "Use Trend Filter (EMA 200)")

// ============================================
// INDICATORS
// ============================================
[bbMiddle, bbUpper, bbLower] = ta.bb(close, bbLength, bbStd)
ema200 = ta.ema(close, 200)
rsi = ta.rsi(close, 14)

// Calculate candle body
body = math.abs(close - open)
avgBody = ta.sma(body, 10)

// ============================================
// SIGNAL LOGIC
// ============================================

// Check if candle is impulsive
isImpulsive = body > avgBody * bodyRatioMin

// Trend filter
bullishTrend = not useTrendFilter or close > ema200
bearishTrend = not useTrendFilter or close < ema200

// LONG: Green candle closes above upper band + impulsive + trend
longCondition = close > open and close > bbUpper and isImpulsive and bullishTrend and rsi > 50

// SHORT: Red candle closes below lower band + impulsive + trend
shortCondition = close < open and close < bbLower and isImpulsive and bearishTrend and rsi < 50

// ============================================
// TRADING LOGIC
// ============================================

// Entry LONG (Fixed SL/TP %)
if longCondition and strategy.position_size == 0
    sl = close * (1 - slPercent / 100)
    tp = close * (1 + tpPercent / 100)
    strategy.entry("Long", strategy.long)
    strategy.exit("Exit Long", "Long", stop=sl, limit=tp)

// Entry SHORT (Fixed SL/TP %)
if shortCondition and strategy.position_size == 0
    sl = close * (1 + slPercent / 100)
    tp = close * (1 - tpPercent / 100)
    strategy.entry("Short", strategy.short)
    strategy.exit("Exit Short", "Short", stop=sl, limit=tp)

// ============================================
// VISUALIZATION
// ============================================

// Plot Bollinger Bands
plot(bbUpper, "BB Upper", color=color.red, linewidth=1)
plot(bbMiddle, "BB Middle", color=color.gray, linewidth=1)
plot(bbLower, "BB Lower", color=color.green, linewidth=1)
plot(ema200, "EMA 200", color=color.blue, linewidth=2)

// Fill between bands
fill(plot(bbUpper), plot(bbLower), color=color.new(color.blue, 95))

// Plot signals
plotshape(longCondition, "Long", shape.triangleup, location.belowbar, color.green, size=size.small)
plotshape(shortCondition, "Short", shape.triangledown, location.abovebar, color.red, size=size.small)

// Highlight impulsive candles
barcolor(isImpulsive ? (close > open ? color.green : color.red) : na)

// Background trend
bgcolor(close > ema200 ? color.new(color.green, 97) : color.new(color.red, 97))
