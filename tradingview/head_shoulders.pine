//@version=5
strategy("Head & Shoulders Pattern", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=95)

// ============================================
// PARAMETERS
// ============================================
shoulderTolerance = input.float(5.0, "Shoulder Tolerance (%)", minval=1.0, maxval=10.0) / 100
minCandles = input.int(60, "Min Formation Candles", minval=40, maxval=100)
requireVolumeConfirmation = input.bool(true, "Require Volume Confirmation")

// ============================================
// INDICATORS
// ============================================
rsi = ta.rsi(close, 14)
volumeSMA = ta.sma(volume, 20)

// Find peaks and troughs
highPeak = ta.pivothigh(high, 7, 7)
lowTrough = ta.pivotlow(low, 7, 7)

// ============================================
// PATTERN DETECTION
// ============================================

// Store recent peaks/troughs
var float[] recentPeaks = array.new_float(0)
var int[] recentPeaksBar = array.new_int(0)
var float[] recentPeaksVolume = array.new_float(0)
var float[] recentTroughs = array.new_float(0)
var int[] recentTroughsBar = array.new_int(0)

// Update peaks
if not na(highPeak)
    array.push(recentPeaks, highPeak)
    array.push(recentPeaksBar, bar_index)
    array.push(recentPeaksVolume, volume)
    if array.size(recentPeaks) > 5
        array.shift(recentPeaks)
        array.shift(recentPeaksBar)
        array.shift(recentPeaksVolume)

// Update troughs
if not na(lowTrough)
    array.push(recentTroughs, lowTrough)
    array.push(recentTroughsBar, bar_index)
    if array.size(recentTroughs) > 5
        array.shift(recentTroughs)
        array.shift(recentTroughsBar)

// ============================================
// HEAD & SHOULDERS (Bearish)
// ============================================
headAndShoulders = false
var line leftShoulderLine = na
var line headLine = na
var line rightShoulderLine = na
var line necklineLine = na

if array.size(recentPeaks) >= 3 and array.size(recentTroughs) >= 2
    // Get peaks
    leftShoulder = array.get(recentPeaks, array.size(recentPeaks) - 3)
    head = array.get(recentPeaks, array.size(recentPeaks) - 2)
    rightShoulder = array.get(recentPeaks, array.size(recentPeaks) - 1)
    
    // Get bars
    leftShoulderBar = array.get(recentPeaksBar, array.size(recentPeaksBar) - 3)
    headBar = array.get(recentPeaksBar, array.size(recentPeaksBar) - 2)
    rightShoulderBar = array.get(recentPeaksBar, array.size(recentPeaksBar) - 1)
    
    // Validate: head is highest
    if head > leftShoulder and head > rightShoulder
        // Check shoulders are similar
        shoulderDiff = math.abs(leftShoulder - rightShoulder) / leftShoulder
        
        if shoulderDiff < shoulderTolerance
            // Get troughs for neckline
            trough1 = array.get(recentTroughs, array.size(recentTroughs) - 2)
            trough2 = array.get(recentTroughs, array.size(recentTroughs) - 1)
            neckline = (trough1 + trough2) / 2
            
            // Volume confirmation (decreasing on right shoulder)
            if requireVolumeConfirmation
                leftVolume = array.get(recentPeaksVolume, array.size(recentPeaksVolume) - 3)
                rightVolume = array.get(recentPeaksVolume, array.size(recentPeaksVolume) - 1)
                volumeDecreasing = rightVolume < leftVolume
            else
                volumeDecreasing = true
            
            // Breakout confirmation
            if close < neckline and volumeDecreasing
                headAndShoulders := true

// ============================================
// INVERSE HEAD & SHOULDERS (Bullish)
// ============================================
inverseHeadAndShoulders = false

if array.size(recentTroughs) >= 3 and array.size(recentPeaks) >= 2
    // Get troughs
    leftShoulder = array.get(recentTroughs, array.size(recentTroughs) - 3)
    head = array.get(recentTroughs, array.size(recentTroughs) - 2)
    rightShoulder = array.get(recentTroughs, array.size(recentTroughs) - 1)
    
    // Validate: head is lowest
    if head < leftShoulder and head < rightShoulder
        // Check shoulders are similar
        shoulderDiff = math.abs(leftShoulder - rightShoulder) / leftShoulder
        
        if shoulderDiff < shoulderTolerance
            // Get peaks for neckline
            peak1 = array.get(recentPeaks, array.size(recentPeaks) - 2)
            peak2 = array.get(recentPeaks, array.size(recentPeaks) - 1)
            neckline = (peak1 + peak2) / 2
            
            // Breakout confirmation
            if close > neckline
                inverseHeadAndShoulders := true

// ============================================
// TRADING LOGIC
// ============================================

// Entry SHORT (H&S)
if headAndShoulders and strategy.position_size == 0
    head = array.get(recentPeaks, array.size(recentPeaks) - 2)
    trough1 = array.get(recentTroughs, array.size(recentTroughs) - 2)
    trough2 = array.get(recentTroughs, array.size(recentTroughs) - 1)
    neckline = (trough1 + trough2) / 2
    
    patternHeight = head - neckline
    sl = neckline * 1.02
    tp = close - patternHeight * 1.0
    
    strategy.entry("Short", strategy.short)
    strategy.exit("Exit Short", "Short", stop=sl, limit=tp)

// Entry LONG (Inverse H&S)
if inverseHeadAndShoulders and strategy.position_size == 0
    head = array.get(recentTroughs, array.size(recentTroughs) - 2)
    peak1 = array.get(recentPeaks, array.size(recentPeaks) - 2)
    peak2 = array.get(recentPeaks, array.size(recentPeaks) - 1)
    neckline = (peak1 + peak2) / 2
    
    patternHeight = neckline - head
    sl = neckline * 0.98
    tp = close + patternHeight * 1.0
    
    strategy.entry("Long", strategy.long)
    strategy.exit("Exit Long", "Long", stop=sl, limit=tp)

// ============================================
// VISUALIZATION
// ============================================

// Plot signals
plotshape(headAndShoulders, "H&S", shape.labeldown, location.abovebar, color.red, text="H&S", size=size.normal)
plotshape(inverseHeadAndShoulders, "Inv H&S", shape.labelup, location.belowbar, color.green, text="IH&S", size=size.normal)

// Plot RSI for divergence analysis
plot(rsi, "RSI", color=color.blue, display=display.none)
hline(50, "RSI Mid", color=color.gray, linestyle=hline.style_dotted)
