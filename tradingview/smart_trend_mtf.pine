//@version=5
strategy("Smart Trend MTF Strategy", overlay=true, initial_capital=1000, default_qty_type=strategy.percent_of_equity, default_qty_value=100)

// ============================================
// MULTI-TIMEFRAME STRATEGY
// ============================================
// Setup (15m): Trend Filter + Pullback to EMA 21
// Trigger (1m): Micro Break of Structure (BOS)
// ============================================

// === INPUTS ===
ema21_length = input.int(21, "EMA 21 Length", minval=1)
ema50_length = input.int(50, "EMA 50 Length", minval=1)
atr_length = input.int(14, "ATR Length", minval=1)
rr_ratio = input.float(2.5, "Risk:Reward Ratio", minval=1.0, step=0.5)
pullback_tolerance = input.float(0.002, "Pullback Tolerance %", minval=0.0001, step=0.0001)

// === INDICATORS (15m Context) ===
ema_21 = ta.ema(close, ema21_length)
ema_50 = ta.ema(close, ema50_length)
atr = ta.atr(atr_length)

// === PLOT INDICATORS ===
plot(ema_21, "EMA 21", color=color.new(color.blue, 0), linewidth=2)
plot(ema_50, "EMA 50", color=color.new(color.orange, 0), linewidth=2)

// === SETUP DETECTION (15m) ===
// LONG Setup: Price above EMA 50 and touches EMA 21
long_trend = close > ema_50
long_pullback = low <= ema_21 * (1 + pullback_tolerance)
long_setup = long_trend and long_pullback

// SHORT Setup: Price below EMA 50 and touches EMA 21
short_trend = close < ema_50
short_pullback = high >= ema_21 * (1 - pullback_tolerance)
short_setup = short_trend and short_pullback

// === TRIGGER DETECTION (Micro-BOS) ===
// Note: TradingView ne permet pas de requêter plusieurs timeframes dans une stratégie facilement
// On simule le micro-BOS avec les 3 dernières bougies de la timeframe actuelle

// LONG Trigger: Close > High of last 3 candles
high_of_last_3 = math.max(high[1], high[2], high[3])
long_trigger = close > high_of_last_3

// SHORT Trigger: Close < Low of last 3 candles
low_of_last_3 = math.min(low[1], low[2], low[3])
short_trigger = close < low_of_last_3

// === ENTRY CONDITIONS ===
long_entry = long_setup and long_trigger
short_entry = short_setup and short_trigger

// === STOP LOSS & TAKE PROFIT ===
// LONG: SL = Swing Low (last 10 bars) - 0.2 ATR
// SHORT: SL = Swing High (last 10 bars) + 0.2 ATR

var float long_sl = na
var float long_tp = na
var float short_sl = na
var float short_tp = na

if long_entry
    swing_low = ta.lowest(low, 10)
    long_sl := swing_low - (0.2 * atr)
    risk = close - long_sl
    long_tp := close + (rr_ratio * risk)

if short_entry
    swing_high = ta.highest(high, 10)
    short_sl := swing_high + (0.2 * atr)
    risk = short_sl - close
    short_tp := close - (rr_ratio * risk)

// === STRATEGY EXECUTION ===
if long_entry and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
    strategy.exit("Long Exit", "Long", stop=long_sl, limit=long_tp)
    
if short_entry and strategy.position_size == 0
    strategy.entry("Short", strategy.short)
    strategy.exit("Short Exit", "Short", stop=short_sl, limit=short_tp)

// === VISUAL SIGNALS ===
// Setup Zones
bgcolor(long_setup ? color.new(color.green, 90) : na, title="Long Setup Zone")
bgcolor(short_setup ? color.new(color.red, 90) : na, title="Short Setup Zone")

// Entry Signals
plotshape(long_entry, "Long Entry", shape.triangleup, location.belowbar, color.new(color.green, 0), size=size.small)
plotshape(short_entry, "Short Entry", shape.triangledown, location.abovebar, color.new(color.red, 0), size=size.small)

// SL/TP Lines (only when in position)
plot(strategy.position_size > 0 ? long_sl : na, "Long SL", color=color.new(color.red, 0), linewidth=1, style=plot.style_linebr)
plot(strategy.position_size > 0 ? long_tp : na, "Long TP", color=color.new(color.green, 0), linewidth=1, style=plot.style_linebr)
plot(strategy.position_size < 0 ? short_sl : na, "Short SL", color=color.new(color.red, 0), linewidth=1, style=plot.style_linebr)
plot(strategy.position_size < 0 ? short_tp : na, "Short TP", color=color.new(color.green, 0), linewidth=1, style=plot.style_linebr)

// === ALERTS ===
alertcondition(long_entry, "Long Entry", "Smart Trend: LONG Entry Signal")
alertcondition(short_entry, "Short Entry", "Smart Trend: SHORT Entry Signal")

// === PERFORMANCE TABLE ===
if barstate.islast
    var table perf_table = table.new(position.top_right, 2, 5, border_width=1)
    
    table.cell(perf_table, 0, 0, "Metric", bgcolor=color.new(color.gray, 70), text_color=color.white)
    table.cell(perf_table, 1, 0, "Value", bgcolor=color.new(color.gray, 70), text_color=color.white)
    
    table.cell(perf_table, 0, 1, "Net Profit", text_color=color.white)
    table.cell(perf_table, 1, 1, str.tostring(strategy.netprofit, "#.##") + " USDC", 
               bgcolor=strategy.netprofit > 0 ? color.new(color.green, 70) : color.new(color.red, 70), 
               text_color=color.white)
    
    table.cell(perf_table, 0, 2, "Win Rate", text_color=color.white)
    win_rate = strategy.wintrades / strategy.closedtrades * 100
    table.cell(perf_table, 1, 2, str.tostring(win_rate, "#.#") + "%", 
               bgcolor=win_rate > 50 ? color.new(color.green, 70) : color.new(color.red, 70), 
               text_color=color.white)
    
    table.cell(perf_table, 0, 3, "Total Trades", text_color=color.white)
    table.cell(perf_table, 1, 3, str.tostring(strategy.closedtrades), text_color=color.white)
    
    table.cell(perf_table, 0, 4, "Profit Factor", text_color=color.white)
    table.cell(perf_table, 1, 4, str.tostring(strategy.grossprofit / strategy.grossloss, "#.##"), 
               bgcolor=strategy.grossprofit / strategy.grossloss > 1.5 ? color.new(color.green, 70) : color.new(color.red, 70), 
               text_color=color.white)
