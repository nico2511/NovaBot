//@version=5
strategy("Bollinger Breakout Strategy", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=95, commission_value=0.06)

// ============================================
// PARAMETERS
// ============================================
bbLength = input.int(20, "BB Length", minval=10, maxval=50)
bbStd = input.float(2.0, "BB Std Dev", minval=1.0, maxval=3.0)
bodyRatioMin = input.float(1.0, "Min Body Ratio", minval=0.5, maxval=3.0)

// ============================================
// INDICATORS
// ============================================
[bbMiddle, bbUpper, bbLower] = ta.bb(close, bbLength, bbStd)

// Calculate candle body
body = math.abs(close - open)
avgBody = ta.sma(body, 10)

// ============================================
// SIGNAL LOGIC
// ============================================

// Check if candle is impulsive (body > average)
isImpulsive = body > avgBody * bodyRatioMin

// LONG: Green candle closes above upper band + impulsive
longCondition = close > open and close > bbUpper and isImpulsive

// SHORT: Red candle closes below lower band + impulsive
shortCondition = close < open and close < bbLower and isImpulsive

// Exit at middle band
exitLong = close <= bbMiddle
exitShort = close >= bbMiddle

// ============================================
// TRADING LOGIC
// ============================================

// Entry LONG
if longCondition and strategy.position_size == 0
    sl = bbMiddle
    tp = close + (close - bbMiddle) * 1.5
    strategy.entry("Long", strategy.long)
    strategy.exit("Exit Long", "Long", stop=sl, limit=tp)

// Entry SHORT
if shortCondition and strategy.position_size == 0
    sl = bbMiddle
    tp = close - (bbMiddle - close) * 1.5
    strategy.entry("Short", strategy.short)
    strategy.exit("Exit Short", "Short", stop=sl, limit=tp)

// Manual exits at middle band
if strategy.position_size > 0 and exitLong
    strategy.close("Long")

if strategy.position_size < 0 and exitShort
    strategy.close("Short")

// ============================================
// VISUALIZATION
// ============================================

// Plot Bollinger Bands
plot(bbUpper, "BB Upper", color=color.red, linewidth=1)
plot(bbMiddle, "BB Middle", color=color.gray, linewidth=1)
plot(bbLower, "BB Lower", color=color.green, linewidth=1)

// Fill between bands
fill(plot(bbUpper), plot(bbLower), color=color.new(color.blue, 95))

// Plot signals
plotshape(longCondition, "Long", shape.triangleup, location.belowbar, color.green, size=size.small)
plotshape(shortCondition, "Short", shape.triangledown, location.abovebar, color.red, size=size.small)

// Highlight impulsive candles
barcolor(isImpulsive ? (close > open ? color.green : color.red) : na)
