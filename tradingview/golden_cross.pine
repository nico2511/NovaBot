//@version=5
strategy("Golden Cross Strategy", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=95, commission_value=0.06)

// ============================================
// PARAMETERS
// ============================================
fastLength = input.int(50, "Fast SMA Length", minval=10, maxval=100)
slowLength = input.int(200, "Slow SMA Length", minval=100, maxval=300)
exitOnCross = input.bool(true, "Exit on SMA Cross")

// ============================================
// INDICATORS
// ============================================
smaFast = ta.sma(close, fastLength)
smaSlow = ta.sma(close, slowLength)

// ============================================
// SIGNAL LOGIC
// ============================================

// Golden Cross: Fast SMA crosses above Slow SMA
goldenCross = ta.crossover(smaFast, smaSlow)

// Death Cross: Fast SMA crosses below Slow SMA
deathCross = ta.crossunder(smaFast, smaSlow)

// Exit conditions
exitLong = exitOnCross ? deathCross or close < smaFast : close < smaFast
exitShort = exitOnCross ? goldenCross or close > smaFast : close > smaFast

// ============================================
// TRADING LOGIC
// ============================================

// Entry LONG (Golden Cross)
if goldenCross and strategy.position_size == 0
    sl = smaFast * 0.97
    tp = close * 1.10
    strategy.entry("Long", strategy.long)
    strategy.exit("Exit Long", "Long", stop=sl, limit=tp)

// Entry SHORT (Death Cross)
if deathCross and strategy.position_size == 0
    sl = smaFast * 1.03
    tp = close * 0.90
    strategy.entry("Short", strategy.short)
    strategy.exit("Exit Short", "Short", stop=sl, limit=tp)

// Manual exits
if strategy.position_size > 0 and exitLong
    strategy.close("Long")

if strategy.position_size < 0 and exitShort
    strategy.close("Short")

// ============================================
// VISUALIZATION
// ============================================

// Plot SMAs
plot(smaFast, "SMA " + str.tostring(fastLength), color=color.orange, linewidth=2)
plot(smaSlow, "SMA " + str.tostring(slowLength), color=color.blue, linewidth=2)

// Plot signals
plotshape(goldenCross, "Golden Cross", shape.labelup, location.belowbar, color.green, text="GC", size=size.normal)
plotshape(deathCross, "Death Cross", shape.labeldown, location.abovebar, color.red, text="DC", size=size.normal)

// Fill between SMAs
fill(plot(smaFast), plot(smaSlow), color=smaFast > smaSlow ? color.new(color.green, 90) : color.new(color.red, 90))
