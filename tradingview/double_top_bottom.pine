//@version=5
strategy("Double Top/Bottom Pattern", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=95)

// ============================================
// PARAMETERS
// ============================================
tolerance = input.float(2.0, "Price Tolerance (%)", minval=0.1, maxval=10.0) / 100
minCandles = input.int(10, "Min Candles Between Peaks", minval=5, maxval=50)
rsiLength = input.int(14, "RSI Length", minval=5, maxval=50)
requireDivergence = input.bool(true, "Require RSI Divergence")

// ============================================
// INDICATORS
// ============================================
rsi = ta.rsi(close, rsiLength)

// Find local peaks and troughs
highPeak = ta.pivothigh(high, 5, 5)
lowTrough = ta.pivotlow(low, 5, 5)

// ============================================
// PATTERN DETECTION
// ============================================

// Store recent peaks/troughs
var float[] recentPeaks = array.new_float(0)
var int[] recentPeaksBar = array.new_int(0)
var float[] recentTroughs = array.new_float(0)
var int[] recentTroughsBar = array.new_int(0)

// Update peaks
if not na(highPeak)
    array.push(recentPeaks, highPeak)
    array.push(recentPeaksBar, bar_index)
    if array.size(recentPeaks) > 5
        array.shift(recentPeaks)
        array.shift(recentPeaksBar)

// Update troughs
if not na(lowTrough)
    array.push(recentTroughs, lowTrough)
    array.push(recentTroughsBar, bar_index)
    if array.size(recentTroughs) > 5
        array.shift(recentTroughs)
        array.shift(recentTroughsBar)

// ============================================
// DOUBLE BOTTOM (Bullish)
// ============================================
doubleBottom = false
if array.size(recentTroughs) >= 2
    trough1 = array.get(recentTroughs, array.size(recentTroughs) - 2)
    trough2 = array.get(recentTroughs, array.size(recentTroughs) - 1)
    bar1 = array.get(recentTroughsBar, array.size(recentTroughsBar) - 2)
    bar2 = array.get(recentTroughsBar, array.size(recentTroughsBar) - 1)
    
    // Check price similarity
    priceDiff = math.abs(trough1 - trough2) / trough1
    
    // Check candle distance
    candleDistance = bar2 - bar1
    
    if priceDiff < tolerance and candleDistance >= minCandles
        // Check RSI divergence (bullish)
        rsi1 = ta.valuewhen(bar_index == bar1, rsi, 0)
        rsi2 = ta.valuewhen(bar_index == bar2, rsi, 0)
        
        hasDivergence = not requireDivergence or (trough2 <= trough1 and rsi2 > rsi1)
        
        if hasDivergence
            // Calculate neckline
            neckline = math.max(ta.highest(high, bar2 - bar1))
            
            // Breakout confirmation
            if close > neckline
                doubleBottom := true

// ============================================
// DOUBLE TOP (Bearish)
// ============================================
doubleTop = false
if array.size(recentPeaks) >= 2
    peak1 = array.get(recentPeaks, array.size(recentPeaks) - 2)
    peak2 = array.get(recentPeaks, array.size(recentPeaks) - 1)
    bar1 = array.get(recentPeaksBar, array.size(recentPeaksBar) - 2)
    bar2 = array.get(recentPeaksBar, array.size(recentPeaksBar) - 1)
    
    // Check price similarity
    priceDiff = math.abs(peak1 - peak2) / peak1
    
    // Check candle distance
    candleDistance = bar2 - bar1
    
    if priceDiff < tolerance and candleDistance >= minCandles
        // Check RSI divergence (bearish)
        rsi1 = ta.valuewhen(bar_index == bar1, rsi, 0)
        rsi2 = ta.valuewhen(bar_index == bar2, rsi, 0)
        
        hasDivergence = not requireDivergence or (peak2 >= peak1 and rsi2 < rsi1)
        
        if hasDivergence
            // Calculate neckline
            neckline = math.min(ta.lowest(low, bar2 - bar1))
            
            // Breakout confirmation
            if close < neckline
                doubleTop := true

// ============================================
// TRADING LOGIC
// ============================================

// Entry
if doubleBottom and strategy.position_size == 0
    trough2 = array.get(recentTroughs, array.size(recentTroughs) - 1)
    sl = trough2 * 0.99
    tp = close + (close - trough2) * 1.5
    strategy.entry("Long", strategy.long)
    strategy.exit("Exit Long", "Long", stop=sl, limit=tp)

if doubleTop and strategy.position_size == 0
    peak2 = array.get(recentPeaks, array.size(recentPeaks) - 1)
    sl = peak2 * 1.01
    tp = close - (peak2 - close) * 1.5
    strategy.entry("Short", strategy.short)
    strategy.exit("Exit Short", "Short", stop=sl, limit=tp)

// ============================================
// VISUALIZATION
// ============================================

// Plot signals
plotshape(doubleBottom, "Double Bottom", shape.triangleup, location.belowbar, color.green, size=size.small)
plotshape(doubleTop, "Double Top", shape.triangledown, location.abovebar, color.red, size=size.small)

// Plot RSI
hline(70, "Overbought", color.red, linestyle=hline.style_dashed)
hline(30, "Oversold", color.green, linestyle=hline.style_dashed)
plot(rsi, "RSI", color=color.blue, display=display.none)
