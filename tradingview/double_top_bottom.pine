//@version=5
strategy("Double Top/Bottom Pattern", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=95)

// ============================================
// PARAMETERS
// ============================================
tolerance = input.float(2.0, "Price Tolerance (%)", minval=0.1, maxval=10.0) / 100
minCandles = input.int(10, "Min Candles Between Peaks", minval=5, maxval=50)
rsiLength = input.int(14, "RSI Length", minval=5, maxval=50)
requireDivergence = input.bool(true, "Require RSI Divergence")

// ============================================
// INDICATORS
// ============================================
rsi = ta.rsi(close, rsiLength)

// Find local peaks and troughs (simpler approach)
lookback = 5
isHighPeak = high == ta.highest(high, lookback * 2 + 1) and high[lookback] == ta.highest(high[lookback - lookback], lookback * 2 + 1)
isLowTrough = low == ta.lowest(low, lookback * 2 + 1) and low[lookback] == ta.lowest(low[lookback - lookback], lookback * 2 + 1)

// ============================================
// PATTERN DETECTION
// ============================================

// Variables to store pattern info
var float peak1 = na
var float peak2 = na
var int peak1Bar = na
var int peak2Bar = na
var float trough1 = na
var float trough2 = na
var int trough1Bar = na
var int trough2Bar = na

// Update peaks
if isHighPeak
    peak1 := peak2
    peak1Bar := peak2Bar
    peak2 := high[lookback]
    peak2Bar := bar_index - lookback

// Update troughs
if isLowTrough
    trough1 := trough2
    trough1Bar := trough2Bar
    trough2 := low[lookback]
    trough2Bar := bar_index - lookback

// ============================================
// DOUBLE BOTTOM (Bullish)
// ============================================
doubleBottom = false
if not na(trough1) and not na(trough2)
    // Check price similarity
    priceDiff = math.abs(trough1 - trough2) / trough1
    
    // Check candle distance
    candleDistance = trough2Bar - trough1Bar
    
    if priceDiff < tolerance and candleDistance >= minCandles
        // Simple RSI check (current RSI vs RSI at trough)
        currentRSI = rsi
        
        // Calculate neckline (highest point between troughs)
        neckline = ta.highest(high, candleDistance)
        
        // Breakout confirmation
        if close > neckline and currentRSI > 30
            doubleBottom := true

// ============================================
// DOUBLE TOP (Bearish)
// ============================================
doubleTop = false
if not na(peak1) and not na(peak2)
    // Check price similarity
    priceDiff = math.abs(peak1 - peak2) / peak1
    
    // Check candle distance
    candleDistance = peak2Bar - peak1Bar
    
    if priceDiff < tolerance and candleDistance >= minCandles
        // Simple RSI check
        currentRSI = rsi
        
        // Calculate neckline (lowest point between peaks)
        neckline = ta.lowest(low, candleDistance)
        
        // Breakout confirmation
        if close < neckline and currentRSI < 70
            doubleTop := true

// ============================================
// TRADING LOGIC
// ============================================

// Entry LONG (Double Bottom)
if doubleBottom and strategy.position_size == 0
    sl = trough2 * 0.99
    tp = close + (close - trough2) * 1.5
    strategy.entry("Long", strategy.long)
    strategy.exit("Exit Long", "Long", stop=sl, limit=tp)

// Entry SHORT (Double Top)
if doubleTop and strategy.position_size == 0
    sl = peak2 * 1.01
    tp = close - (peak2 - close) * 1.5
    strategy.entry("Short", strategy.short)
    strategy.exit("Exit Short", "Short", stop=sl, limit=tp)

// ============================================
// VISUALIZATION
// ============================================

// Plot signals
plotshape(doubleBottom, "Double Bottom", shape.triangleup, location.belowbar, color.green, size=size.small)
plotshape(doubleTop, "Double Top", shape.triangledown, location.abovebar, color.red, size=size.small)

// Plot RSI levels
hline(70, "Overbought", color.red, linestyle=hline.style_dashed)
hline(30, "Oversold", color.green, linestyle=hline.style_dashed)
