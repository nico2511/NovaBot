//@version=5
strategy("Triangle Breakout", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=95, commission_value=0.06)

// ============================================
// PARAMETERS
// ============================================
lookback = input.int(30, "Lookback Period", minval=20, maxval=100)
volatilityThreshold = input.float(0.8, "Volatility Compression", minval=0.5, maxval=1.0)
volumeMultiplier = input.float(1.5, "Volume Spike Multiplier", minval=1.0, maxval=3.0)
flatnessThreshold = input.float(2.0, "Flatness Threshold (%)", minval=0.5, maxval=5.0) / 100

// ============================================
// INDICATORS
// ============================================
atr = ta.atr(14)
volumeSMA = ta.sma(volume, 20)

// ============================================
// PATTERN DETECTION
// ============================================

// Get recent highs and lows
recentHighs = ta.highest(high, lookback)
recentLows = ta.lowest(low, lookback)

// Calculate resistance and support
resistance = recentHighs
support = recentLows

// Check volatility compression
atrCurrent = atr
atrPast = atr[20]
volatilityDecreasing = atrCurrent < atrPast * volatilityThreshold

// Calculate standard deviation of highs and lows (last 10 bars)
var float[] last10Highs = array.new_float(10, 0)
var float[] last10Lows = array.new_float(10, 0)

// Update arrays
array.shift(last10Highs)
array.push(last10Highs, high)
array.shift(last10Lows)
array.push(last10Lows, low)

// Calculate std dev
highMean = array.avg(last10Highs)
lowMean = array.avg(last10Lows)
highStd = array.stdev(last10Highs) / highMean
lowStd = array.stdev(last10Lows) / lowMean

// Calculate slope
lowsSlope = (low - low[10]) / 10
highsSlope = (high - high[10]) / 10

// ============================================
// ASCENDING TRIANGLE (Bullish)
// ============================================
ascendingTriangle = false
if volatilityDecreasing
    // Flat resistance
    flatResistance = highStd < flatnessThreshold
    
    // Rising support
    risingSupport = lowsSlope > 0
    
    if flatResistance and risingSupport
        // Breakout confirmation
        if close > resistance and volume > volumeSMA * volumeMultiplier
            ascendingTriangle := true

// ============================================
// DESCENDING TRIANGLE (Bearish)
// ============================================
descendingTriangle = false
if volatilityDecreasing
    // Flat support
    flatSupport = lowStd < flatnessThreshold
    
    // Falling resistance
    fallingResistance = highsSlope < 0
    
    if flatSupport and fallingResistance
        // Breakout confirmation
        if close < support and volume > volumeSMA * volumeMultiplier
            descendingTriangle := true

// ============================================
// TRADING LOGIC
// ============================================

// Calculate triangle height
triangleHeight = resistance - support

// Entry LONG
if ascendingTriangle and strategy.position_size == 0
    sl = support * 0.99
    tp = close + triangleHeight * 1.0
    strategy.entry("Long", strategy.long)
    strategy.exit("Exit Long", "Long", stop=sl, limit=tp)

// Entry SHORT
if descendingTriangle and strategy.position_size == 0
    sl = resistance * 1.01
    tp = close - triangleHeight * 1.0
    strategy.entry("Short", strategy.short)
    strategy.exit("Exit Short", "Short", stop=sl, limit=tp)

// ============================================
// VISUALIZATION
// ============================================

// Plot triangle lines
plot(resistance, "Resistance", color=color.red, linewidth=2)
plot(support, "Support", color=color.green, linewidth=2)

// Plot signals
plotshape(ascendingTriangle, "Ascending", shape.triangleup, location.belowbar, color.green, size=size.normal)
plotshape(descendingTriangle, "Descending", shape.triangledown, location.abovebar, color.red, size=size.normal)

// Background for volatility compression
bgcolor(volatilityDecreasing ? color.new(color.yellow, 95) : na)
